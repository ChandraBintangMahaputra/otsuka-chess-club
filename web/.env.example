# Koneksi Postgres Supabase (transaction pooler), dipakai aplikasi di server
DATABASE_URL=
# Session pooler, dipakai skrip migrasi dan seed
DIRECT_URL=
# String acak panjang: openssl rand -hex 32
SESSION_SECRET=
# Dipakai Vercel Cron memanggil /api/cron/daily
CRON_SECRET=
# URL website, dipakai metadata dan MCP artikel untuk memperbarui cache
SITE_URL=
# Isi "true" bila website boleh diindeks mesin pencari (default: noindex, situs internal)
PUBLIC_SITE=
